DATABASE_URL=sqlite:///./data/velastyle.db

# Cookie phiên đăng nhập. Đặt COOKIE_SECURE=true khi chạy HTTPS.
# COOKIE_SAMESITE: lax (mặc định) | strict | none. 'none' chỉ hoạt động khi COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
SESSION_DAYS=7

# CORS: danh sách origin được phép gọi API từ trang khác, ngăn cách bằng dấu phẩy, không có dấu / cuối.
# Để trống = chỉ cùng origin (an toàn nhất). Ví dụ: http://localhost:5173,https://velastyle.example.com
# Origin được liệt kê cũng được miễn kiểm tra CSRF same-origin, và cần COOKIE_SAMESITE=none + COOKIE_SECURE=true
# nếu trình duyệt phải gửi cookie đăng nhập từ site khác.
CORS_ORIGINS=

# Giới hạn đăng ký/đăng nhập mỗi IP mỗi phút; kích thước ảnh tải lên tối đa (MB)
RATE_LIMIT_PER_MINUTE=20
MAX_UPLOAD_MB=5

# Giao diện: react (mặc định, cần app/static/dist) | legacy (JavaScript thuần cũ, dự phòng)
FRONTEND=react

# Gợi ý AI
CLIP_MODEL=openai/clip-vit-base-patch32
CLIP_DEVICE=cpu
HYBRID_ALPHA=0.5

# Email (SMTP) gửi mã xác nhận và mã đặt lại mật khẩu. Để trống SMTP_HOST = chế độ dev: mã chỉ ghi ra log server.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURITY=starttls, SMTP_USER=địa chỉ Gmail,
# SMTP_PASSWORD=mật khẩu ứng dụng 16 ký tự (cần bật xác minh 2 bước). Chỉ điền giá trị thật trong .env, KHÔNG điền ở file này.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_CODE_MINUTES=10
# Thời gian tối thiểu giữa hai lần gửi mã cho cùng một email (giây)
EMAIL_RESEND_SECONDS=120

# Đăng nhập bằng Google (OAuth 2.0, Google Cloud Console > APIs & Services > Credentials > OAuth client ID, loại Web application).
# Authorized redirect URI phải khớp chính xác GOOGLE_REDIRECT_URI. Để trống ID/secret = ẩn nút Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8010/api/auth/google/callback
